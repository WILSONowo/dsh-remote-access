{
  "description": "DSH host APIs this plugin calls and the wire it sends to the phone. test/protocol-contract.test.mjs checks the plugin against this file; the app keeps a copy of the frame fixtures in app/src/test/resources/protocol.",
  "verifiedHostVersions": ["0.2.1-rc.5", "0.2.2-rc.1"],
  "verifiedHostSeries": ["0.2"],
  "hostEndpoints": {
    "invoke": [
      "agentPresets/list",
      "commands/execute",
      "commands/list",
      "directoryPicker/list",
      "session/cancel",
      "session/create",
      "session/list",
      "session/modelCatalog",
      "session/page",
      "session/projections",
      "session/prompt",
      "session/rename",
      "session/search",
      "session/selectModel",
      "skills/list",
      "workspace/archiveSession",
      "workspace/create",
      "workspace/insertSessionBefore",
      "workspace/unarchiveSession"
    ],
    "stream": ["$events", "session/follow", "workspace/follow"],
    "rpc": ["$events/result"]
  },
  "phoneRpcs": [
    "agentPreset.list",
    "commands/execute",
    "commands/list",
    "host.describe",
    "host.listDirectory",
    "session.cancel",
    "session.create",
    "session.history",
    "session.list",
    "session.models",
    "session.prompt",
    "session.rename",
    "session.search",
    "session.selectModel",
    "skill.list",
    "workspace.archiveSession",
    "workspace.create",
    "workspace.insertSessionBefore",
    "workspace.list",
    "workspace.unarchiveSession"
  ],
  "muxFrames": [
    "approval/requested",
    "approval/resolved",
    "host/session-added",
    "host/session-removed",
    "host/session-status",
    "host/workspace-changed",
    "question/requested",
    "question/resolved",
    "session/event",
    "session/projection",
    "session/subscribed",
    "stream/error"
  ]
}
