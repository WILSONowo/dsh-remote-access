{
  "name": "dsh-remote-access",
  "version": "3.2.1",
  "description": "Remote access to DSH: supports direct LAN connections, tunneling, and self-hosted servers, with protocol compatibility for 0.2.1-rc.5.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./tunnel": "./lib/tunnel.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:client": "esbuild src/client.ts --bundle --platform=browser --format=iife --outfile=lib/client.js --target=es2020",
    "test": "node --test test/*.test.mjs smoke-test.mjs",
    "prepack": "npm run typecheck && npm run build && npm run build:client && npm test",
    "pack": "npm pack"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.7 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.2.1-rc.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "1.4.4",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
